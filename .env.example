# ====================================================
# 喃喃 Murmur - 全栈环境变量配置
# ====================================================

# 服务端端口（前后端一体时默认为 3001）
PORT=3001

# Supabase 数据库配置
# 可在 https://supabase.com 控制台 -> Project Settings -> API 中获取
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# 可选：Service Role 密钥（具备管理员权限，若配置则优先使用进行全权限数据操作）
SUPABASE_SERVICE_ROLE_KEY=""

# Gemini AI 模型密钥（用于回音海纸飞机温暖共情回音生成）
# 可选，若未配置将优雅降级至内置的高品质诗意回音文案库
GEMINI_API_KEY=""

# 前端应用访问地址
APP_URL="http://localhost:3000"
